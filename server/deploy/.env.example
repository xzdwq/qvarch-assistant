# Copy to .env next to compose.yml on the server and fill in. .env is never committed.

# The image pushed by server/scripts/publish.ps1
QA_IMAGE=registry.example.com/qvarch/transport:latest
# The database's password (letters and digits: it goes into a connection URL)
QA_DB_PASSWORD=change-me
# The apps must know this code to connect (empty — any app of the network may)
QA_ACCESS_CODE=
# The port the apps connect to
QA_PUBLISH_PORT=3000
# The containers' own network: a range used nowhere in your network
QA_SUBNET=10.250.0.0/24
