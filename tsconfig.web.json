{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@shared/*": ["./src/shared/*"], "@nb/*": ["./src/notebook/*"], "@renderer/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.vue", "src/renderer/env.d.ts", "src/renderer/shims.d.ts", "src/shared/**/*", "src/notebook/**/*.ts", "src/notebook/**/*.vue"]
}
