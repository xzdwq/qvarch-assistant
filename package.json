    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "marked": "^18.1.0",
    "simple-git": "^3.36.0",
    "thinking-orbs": "^0.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
